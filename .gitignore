# ---- Secretos: NUNCA versionar ----
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---- Dependencias y compilados ----
node_modules/
dist/
build/
.vite/

# ---- Wrangler (CLI de Cloudflare) ----
# Guarda en caché el id y el correo de la cuenta: no son secretos, pero no
# tienen por qué estar en un repositorio público.
.wrangler/

# ---- Supabase CLI ----
supabase/.temp/
supabase/.branches/

# ---- Respaldos ----
# NUNCA en este repositorio: es público y los respaldos llevan datos de menores.
# Van a un repositorio privado aparte (ver docs/PLAN.md §5).
backups/

# ---- Referencia visual de diseño ----
# Capturas del Aula Virtual de la UISIL. Se quedan en tu disco y NO se versionan:
# llevan número de cédula, nombres y aportes de terceros. Se citan en docs/PLAN.md.
imagenes/

# ---- Registros locales ----
scripts/keep-alive.log
*.log

# ---- Sistema operativo / editores ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
